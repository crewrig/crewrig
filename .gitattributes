# Enforce LF line endings for all text files
* text=auto eol=lf

# Explicit LF for scripts and config
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.md text eol=lf

# Skill-script oracle goldens record the exact bytes a script wrote, carriage returns included.
scripts/tests/fixtures/skill-scripts/** -text
