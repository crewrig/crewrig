# System files
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime
node_modules
__pycache__/
*.pyc
.venv/
dist/
dist-claude-plugin/
build/

# CI cache directory (persisted by engine cache, never committed)
.ci-cache/

# Environment
.env
.env.local

# Personal configuration (not committed)
config/PROFILE.md
config/SOUL.md

# Claude Code local settings (per-user, not committed)
.claude/settings.local.json
CLAUDE.local.md

# GitHub Copilot CLI local settings (per-user, not committed)
.github/copilot/settings.local.json
copilot-instructions.local.md

# Timestamped backup left by backup_file() next to settings.json during the
# transcript-hooks opt-in merge (spec 0097 / issue #605) — scoped narrowly to
# that one file, not the whole .github/copilot directory
.github/copilot/settings.json.bak.*

# e2e runner — local overrides and per-run reports (issue #78)
tests/e2e/local.toml
tests/e2e/reports/*
!tests/e2e/reports/.gitkeep

# Antigravity CLI
.agents/settings.local.json
ANTIGRAVITY.local.md
dist-antigravity-*/

# GitHub Copilot CLI plugin build outputs
dist-copilot-plugin/
