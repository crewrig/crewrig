[Unit]
Description=CrewRig scheduled job io.crewrig.harness-curator

[Service]
Type=oneshot
Environment="PATH=<SANDBOX>/bin"
ExecStart=<NODE> <SCRIPTS>/curate --apply --dedup --max-issues 5
StandardOutput=append:<HOME>/.local/state/crewrig/harness-curator.log
StandardError=append:<HOME>/.local/state/crewrig/harness-curator.log
