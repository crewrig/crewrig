# extracted from scripts/manage-workspace-component.sh at origin/release/1231-ts-migration before the switch (spec 0255 PR E)
types-echo: commands, skills, hooks, agents, policies, mcp-servers, themes
alias: command -> commands
alias: skill -> skills
alias: hook -> hooks
alias: agent -> agents
alias: policy -> policies
alias: mcp-server -> mcp-servers
alias: theme -> themes
staging-root: .gemini/skills
staging-root: .gemini/agents
artifact-root: $TYPE
artifact-root: $TYPE
prompt: false
mode-default: true
link-warning: WARNING: Symlink mode — the installed component is a link into this
link-warning:          repository, so a branch switch changes it in place.
link-warning:          For skills and agents the link target is the regenerable
link-warning:          staging tree dist/<tier>/, which a rebuild replaces wholesale:
link-warning:          an edit to the authoring source under artifacts/ takes effect
link-warning:          only after 'bash scripts/build-components.sh' has run.
link-warning: Only use if you trust all branches in this repository.
home: .gemini
marker: commands|skills|hooks|agents|policies)
marker: DEST="$GEMINI_HOME/$TYPE"
marker: skills) component_set_staging_roots ".gemini/skills"; REFRESH_CLI="gemini"
marker: agents) component_set_staging_roots ".gemini/agents"; REFRESH_CLI="gemini"
marker: mcp-servers|themes)
marker: KEY="mcpServers"
marker: [ "$TYPE" = "themes" ] && KEY="themes"
marker: settings_file="$GEMINI_HOME/settings.json"
