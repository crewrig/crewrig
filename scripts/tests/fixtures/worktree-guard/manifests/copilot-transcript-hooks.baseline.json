{
  "version": 1,
  "disableAllHooks": false,
  "hooks": {
    "preToolUse": [
      {
        "type": "command",
        "command": "bash \"${COPILOT_PROJECT_DIR:-$PWD}/hooks/worktree-git-guard.sh\""
      }
    ],
    "sessionStart": [
      {
        "type": "command",
        "command": "bash \"${COPILOT_PROJECT_DIR:-$PWD}/hooks/mempalace-transcript.sh\""
      }
    ],
    "userPromptSubmitted": [
      {
        "type": "command",
        "command": "bash \"${COPILOT_PROJECT_DIR:-$PWD}/hooks/mempalace-transcript.sh\""
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "command": "bash \"${COPILOT_PROJECT_DIR:-$PWD}/hooks/mempalace-transcript.sh\""
      }
    ],
    "agentStop": [
      {
        "type": "command",
        "command": "bash \"${COPILOT_PROJECT_DIR:-$PWD}/hooks/mempalace-transcript.sh\""
      }
    ],
    "sessionEnd": [
      {
        "type": "command",
        "command": "bash \"${COPILOT_PROJECT_DIR:-$PWD}/hooks/mempalace-transcript.sh\""
      }
    ]
  }
}
