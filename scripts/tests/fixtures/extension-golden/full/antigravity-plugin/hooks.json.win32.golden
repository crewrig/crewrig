{
  "full-hooks": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "set NoDefaultCurrentDirectoryInExePath=1&& bash hooks/h.sh x"
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "set NoDefaultCurrentDirectoryInExePath=1&& bash hooks/h.sh"
          }
        ]
      }
    ]
  }
}
