  {
    "id": "install-seqthink",
    "header": {
      "antigravity": "Include SequentialThinking MCP server in mcp_config.json?",
      "claude": "Install Sequential Thinking MCP server?"
    },
    "options": [
      "yes",
      "no"
    ],
    "clis": [
      "antigravity",
      "claude"
    ],
    "condition": "always",
    "askedIn": {
      "antigravity": [
        "full",
        "rules",
        "tier-community",
        "tier-org",
        "usage-keep"
      ],
      "claude": [
        "full",
        "rules",
        "tier-community",
        "tier-org",
        "usage-keep"
      ]
    },
    "cancel": {
      "antigravity": "abort",
      "claude": "abort"
    }
  },
  {
    "id": "install-settings",
    "header": {
      "claude": "Install default settings.json?"
    },
    "options": [
      "yes",
      "no"
    ],
    "clis": [
      "claude"
    ],
    "condition": "~/.claude/settings.json is absent",
    "askedIn": {
      "claude": [
        "full",
        "rules",
        "tier-community",
        "tier-org"
      ]
    },
    "cancel": {
      "claude": "abort"
    }
  },
  {
    "id": "legacy-mcp-removal",
    "header": {
      "claude": "Remove legacy ~/.claude/mcp.json (backup will be kept)?"
    },
    "options": [
      "no",
      "yes"
    ],
    "clis": [
      "claude"
    ],
    "condition": "~/.claude/mcp.json exists",
    "askedIn": {
      "claude": [
        "full"
      ]
    },
    "cancel": {
      "claude": "abort"
    }
  },
  {
    "id": "link-confirm",
    "header": {
      "antigravity": "Continue with symlink mode? [y/N] ",
      "claude": "Continue with symlink mode? [y/N] ",
      "gemini": "Continue with symlink mode? [y/N] "
    },
    "options": [
      "no",
      "yes"
    ],
    "clis": [
      "antigravity",
      "claude",
      "gemini"
    ],
    "condition": "--link is given (one key read, not fzf)",
    "cancel": {
      "antigravity": "none",
      "claude": "none",
      "gemini": "none"
    }
  },
