[
  {
    "id": "catalogue.expertise",
    "header": {
      "antigravity": "head -20 <REPO>/config/expertise/{}.md",
      "claude": "head -20 <REPO>/config/expertise/{}.md",
      "copilot": "head -20 <REPO>/config/expertise/{}.md",
      "gemini": "head -20 <REPO>/config/expertise/{}.md"
    },
    "options": [
      "@catalogue:config/expertise"
    ],
    "clis": [
      "antigravity",
      "claude",
      "copilot",
      "gemini"
    ],
    "condition": "rules not kept and the catalogue is not empty",
    "askedIn": {
      "antigravity": [
        "full",
        "tier-community",
        "tier-org",
        "usage-keep"
      ],
      "claude": [
        "full",
        "tier-community",
        "tier-org",
        "usage-keep"
      ],
      "copilot": [
        "full",
        "tier-community",
        "tier-org",
        "usage-keep"
      ],
      "gemini": [
        "full",
        "tier-community",
        "tier-org",
        "usage-keep"
      ]
    },
    "cancel": {
      "antigravity": "decline",
      "claude": "decline",
      "copilot": "decline",
      "gemini": "decline"
    }
  },
