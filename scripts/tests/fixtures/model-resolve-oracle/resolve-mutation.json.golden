    "prose": "Run this agent on the opus-org-o2 model.",
    "diagLines": [
     "model-note\tprobe\tclaude\tguard-withheld\tterms=defect-not-established-fixed,copilot-reader-consumes-claude-surface surface=guidance"
    ],
    "handle": "<MERGE>/ec193094cdc15e2e2440700b99aaf31992598d311a2cb448c62a2d60a522971f/claude.yml",
