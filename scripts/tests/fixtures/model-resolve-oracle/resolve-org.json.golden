surface.\"\n          - declares: \"domain\"\n            citation: \"RR -> Gemini CLI -> Declaration surface: the bundled subagents.md table states an integer of at least 1 for `max_turns`.\"\n  - id: \"settings-overrides\"\n    kind: \"out-of-band\"\n    location: \"settings.json `modelConfigs.overrides`, matched to an agent by `overrideScope` (spec 0197 R40). Recorded as evidence directing no emission (R12) — this mapping declares no guidance surface, so reasoning and the three generation knobs below are dropped with the reason unsupported-on-cli rather than directed here.\"\n    items:\n      - item: \"reasoning\"\n        grounds:\n          - declares: \"item\"\n            citation: \"RR -> Gemini CLI -> No native reasoning field: `thinkingLevel` / `thinkingBudget` are reachable only through `settings.json` `modelConfigs.overrides`, never through the agent-file frontmatter surface (spec 0197 Premise 2).\"\n      - item: \"top-p\"\n        grounds:\n          - declares: \"item\"\n            citation: \"RR -> Gemini CLI -> No native reasoning field: `topP` is reachable only through `settings.json` `modelConfigs.overrides`.\"\n      - item: \"top-k\"\n        grounds:\n          - declares: \"item\"\n            citation: \"RR -> Gemini CLI -> No native reasoning field: `topK` is reachable only through `settings.json` `modelConfigs.overrides`.\"\n      - item: \"max-output-tokens\"\n        grounds:\n          - declares: \"item\"\n            citation: \"RR -> Gemini CLI -> No native reasoning field: `maxOutputTokens` is reachable only through `settings.json` `modelConfigs.overrides`.\"\nofferings:\n  - id: \"gemini-3.1-flash-lite\"\n    rank: 1\n    native-value: \"gemini-3.1-flash-lite\"\n    provides:\n      intelligence: \"low\"\n      specialization: \"general\"\n    encodes:\n      intelligence: \"flash\"\n    supports-reasoning-surface: false\n    grounds:\n      - declares: \"native-value\"\n        citation: \"RR -> Gemini CLI -> Model-id spelling: `gemini-3.1-flash-lite` appears verbatim in the `customAliases` enumeration.\"\n      - declares: \"provides.intelligence\"\n        assumption: \"The rung rests on the vendor's own family naming — pro above flash above flash-lite — which is observable in the identifier but is not a capability measurement (spec 0197 `## Open questions`).\"\n      - declares: \"supports-reasoning-surface\"\n        citation: \"This mapping's frontmatter surface declares no reasoning item (spec 0197 R40), so A17 forces false structurally.\"\n  - id: \"gemini-3.5-flash\"\n    rank: 2\n    native-value: \"gemini-3.5-flash\"\n    provides:\n      intelligence: \"medium\"\n      specialization: \"general\"\n    encodes:\n      intelligence: \"flash\"\n    supports-reasoning-surface: false\n    grounds:\n      - declares: \"native-value\"\n        citation: \"RR -> Gemini CLI -> Model-id spelling: `gemini-3.5-flash` appears verbatim in the `customAliases` enumeration.\"\n      - declares: \"provides.intelligence\"\n        assumption: \"Same ground as `gemini-3.1-flash-lite` above: vendor family naming, not a capability measurement (spec 0197 `## Open questions`).\"\n      - declares: \"supports-reasoning-surface\"\n        citation: \"This mapping's frontmatter surface declares no reasoning item (spec 0197 R40), so A17 forces false structurally.\"\n  - id: \"gemini-3.1-pro-preview\"\n    rank: 3\n    native-value: \"gemini-3.1-pro-preview\"\n    provides:\n      intelligence: \"high\"\n      specialization: \"general\"\n    encodes:\n      intelligence: \"pro\"\n    supports-reasoning-surface: false\n    grounds:\n      - declares: \"native-value\"\n        citation: \"RR -> Gemini CLI -> Model-id spelling: `gemini-3.1-pro-preview` appears verbatim in the `customAliases` enumeration.\"\n      - declares: \"provides.intelligence\"\n        assumption: \"Same ground as the two flash offerings above: vendor family naming — pro above flash — not a capability measurement (spec 0197 `## Open questions`).\"\n      - declares: \"supports-reasoning-surface\"\n        citation: \"This mapping's frontmatter surface declares no reasoning item (spec 0197 R40), so A17 forces false structurally.\"\n  - id: \"o11-extra-gemini\"\n    rank: 20\n    native-value: \"o11-extra-native\"\n    provides:\n      intelligence: \"max\"\n      specialization: \"general\"\n    encodes:\n      intelligence: \"o11-extra-gemini\"\n    supports-reasoning-surface: false\n    grounds:\n      - declares: \"native-value\"\n        assumption: \"fixture\"\n      - declares: \"provides.intelligence\"\n        assumption: \"fixture\"\n      - declares: \"supports-reasoning-surface\"\n        assumption: \"fixture\"\n"
  }
