   "27a927312aaa5a7978f64bd288389ab69539fb61993412ef6302153371609019/gemini.yml": "target: gemini\nsurfaces:\n  - id: frontmatter\n    kind: frontmatter\n    items:\n      - item: model\n        key: model\n        domain:\n          values: [gemini-3.1-flash-lite, gemini-3.5-flash, gemini-3.1-pro-preview]\n        grounds:\n          - declares: key\n            citation: >-\n              RR -> Gemini CLI -> Declaration surface, citing the bundled subagents.md table, which documents the native `model` key on a `.gemini/agents/*.md` frontmatter surface.\n          - declares: domain\n            citation: >-\n              RR -> Gemini CLI -> Model-id spelling: all three identifiers this mapping's offerings name appear verbatim in the `customAliases` enumeration. The bundled documentation illustrates the model surface with concrete identifiers and documents no alias domain, so concrete identifiers are what this mapping names (spec 0197 Decision 5).\n      - item: temperature\n        key: temperature\n        domain:\n          type: number\n          min: 0.0\n          max: 2.0\n        grounds:\n          - declares: key\n            citation: >-\n              RR -> Gemini CLI -> Declaration surface, citing the bundled subagents.md table, which documents the native `temperature` key on the same frontmatter surface.\n          - declares: domain\n            citation: >-\n              RR -> Gemini CLI -> Declaration surface: the bundled subagents.md table states the admitted range 0.0 through 2.0 for `temperature`.\n      - item: max-turns\n        key: max_turns\n        domain:\n          type: integer\n          min: 1\n        grounds:\n          - declares: key\n            citation: >-\n              RR -> Gemini CLI -> Declaration surface, citing the bundled subagents.md table, which documents the native `max_turns` key (snake_case, unlike this vocabulary's kebab-case `max-turns` item) on the same frontmatter surface.\n          - declares: domain\n            citation: >-\n              RR -> Gemini CLI -> Declaration surface: the bundled subagents.md table states an integer of at least 1 for `max_turns`.\n  - id: settings-overrides\n    kind: out-of-band\n    location: >-\n      settings.json `modelConfigs.overrides`, matched to an agent by `overrideScope` (spec 0197 R40). Recorded as evidence directing no emission (R12) — this mapping declares no guidance surface, so reasoning and the three generation knobs below are dropped with the reason unsupported-on-cli rather than directed here.\n    items:\n      - item: reasoning\n        grounds:\n          - declares: item\n            citation: >-\n              RR -> Gemini CLI -> No native reasoning field: `thinkingLevel` / `thinkingBudget` are reachable only through `settings.json` `modelConfigs.overrides`, never through the agent-file frontmatter surface (spec 0197 Premise 2).\n      - item: top-p\n        grounds:\n          - declares: item\n            citation: >-\n              RR -> Gemini CLI -> No native reasoning field: `topP` is reachable only through `settings.json` `modelConfigs.overrides`.\n      - item: top-k\n        grounds:\n          - declares: item\n            citation: >-\n              RR -> Gemini CLI -> No native reasoning field: `topK` is reachable only through `settings.json` `modelConfigs.overrides`.\n      - item: max-output-tokens\n        grounds:\n          - declares: item\n            citation: >-\n              RR -> Gemini CLI -> No native reasoning field: `maxOutputTokens` is reachable only through `settings.json` `modelConfigs.overrides`.\nofferings:\n  - id: gemini-3.1-flash-lite\n    rank: 1\n    native-value: gemini-3.1-flash-lite\n    provides:\n      intelligence: low\n      specialization: general\n    encodes:\n      intelligence: flash\n    supports-reasoning-surface: false\n    grounds:\n      - declares: native-value\n        citation: >-\n          RR -> Gemini CLI -> Model-id spelling: `gemini-3.1-flash-lite` appears verbatim in the `customAliases` enumeration.\n      - declares: provides.intelligence\n        assumption: >-\n          The rung rests on the vendor's own family naming — pro above flash above flash-lite — which is observable in the identifier but is not a capability measurement (spec 0197 `## Open questions`).\n      - declares: supports-reasoning-surface\n        citation: >-\n          This mapping's frontmatter surface declares no reasoning item (spec 0197 R40), so A17 forces false structurally.\n  - id: gemini-3.5-flash\n    rank: 2\n    native-value: gemini-3.5-flash\n    provides:\n      intelligence: medium\n      specialization: general\n    encodes:\n      intelligence: flash\n    supports-reasoning-surface: false\n    grounds:\n      - declares: native-value\n        citation: >-\n          RR -> Gemini CLI -> Model-id spelling: `gemini-3.5-flash` appears verbatim in the `customAliases` enumeration.\n      - declares: provides.intelligence\n        assumption: >-\n          Same ground as `gemini-3.1-flash-lite` above: vendor family naming, not a capability measurement (spec 0197 `## Open questions`).\n      - declares: supports-reasoning-surface\n        citation: >-\n          This mapping's frontmatter surface declares no reasoning item (spec 0197 R40), so A17 forces false structurally.\n  - id: gemini-3.1-pro-preview\n    rank: 3\n    native-value: gemini-3.1-pro-preview\n    provides:\n      intelligence: high\n      specialization: general\n    encodes:\n      intelligence: pro\n    supports-reasoning-surface: false\n    grounds:\n      - declares: native-value\n        citation: >-\n          RR -> Gemini CLI -> Model-id spelling: `gemini-3.1-pro-preview` appears verbatim in the `customAliases` enumeration.\n      - declares: provides.intelligence\n        assumption: >-\n          Same ground as the two flash offerings above: vendor family naming — pro above flash — not a capability measurement (spec 0197 `## Open questions`).\n      - declares: supports-reasoning-surface\n        citation: >-\n          This mapping's frontmatter surface declares no reasoning item (spec 0197 R40), so A17 forces false structurally.\n  - id: o11-extra-gemini\n    rank: 20\n    native-value: o11-extra-native\n    provides:\n      intelligence: max\n      specialization: general\n    encodes:\n      intelligence: o11-extra-gemini\n    supports-reasoning-surface: false\n    grounds:\n      - declares: native-value\n        assumption: fixture\n      - declares: provides.intelligence\n        assumption: fixture\n      - declares: supports-reasoning-surface\n        assumption: fixture\n"
  }
