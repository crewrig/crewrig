   "extra/xo_dup-groups#1/claude": {
    "offeringId": "fable",
    "nativeValue": "fable",
    "fmLines": [],
    "prose": "Run this agent on the fable model.",
    "diagLines": [
     "model-note\tprobe\tclaude\tguard-withheld\tterms=defect-not-established-fixed,copilot-reader-consumes-claude-surface surface=guidance"
    ],
    "handle": "<MERGE>/574c3171d0c92c37c3b81e02316db2a855a1aa04d7c696b0ca598751b9bfaf03/claude.yml",
