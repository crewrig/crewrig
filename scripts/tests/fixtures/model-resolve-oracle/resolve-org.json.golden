   ".merges": "claude\n",
   "ff48a197e6b7c537987b0ba65fd75146a6b82e88b08928b7b70126a90dc25bf9/claude.yml": "target: \"claude\"\nsurfaces:\n  - id: \"frontmatter\"\n    kind: \"frontmatter\"\n    items:\n      - item: \"model\"\n        key: \"model\"\n        domain:\n          values:\n            - \"haiku\"\n            - \"sonnet\"\n            - \"opus\"\n            - \"fable\"\n        grounds:\n          - declares: \"key\"\n            citation: \"RR -> Claude Code -> Per-agent frontmatter surface, citing artifacts/FORMAT.md's \\\"Claude Code Overrides\\\" table (line 103), which documents the native `model` key (\\\"Model override\\\") for a `context: fork` component.\"\n          - declares: \"domain\"\n            citation: \"RR -> Claude Code -> Declaration surface: `claude --help` illustrates its --model domain with the family aliases, which spec 0197 Decision 5 makes this mapping's declared domain in preference to concrete identifiers — the one thing the probe found inconsistent on disk.\"\n      - item: \"reasoning\"\n        key: \"effort\"\n        domain:\n          values:\n            - \"low\"\n            - \"medium\"\n            - \"high\"\n            - \"xhigh\"\n            - \"max\"\n        projection:\n          none: \"unmapped\"\n          low: \"low\"\n          medium: \"medium\"\n          high: \"high\"\n          xhigh: \"xhigh\"\n          max: \"max\"\n        grounds:\n          - declares: \"key\"\n            citation: \"RR -> Claude Code -> Per-agent frontmatter surface, citing artifacts/FORMAT.md's \\\"Claude Code Overrides\\\" table (line 103), which documents the native `effort` key (\\\"Effort level override\\\").\"\n          - declares: \"domain\"\n            citation: \"RR -> Claude Code -> Declaration surface: `claude --help` gives --effort the domain low|medium|high|xhigh|max, with no `none`.\"\n          - declares: \"projection.none\"\n            citation: \"The same observation: the domain admits no off state, so the `none` rung has no image and is declared unmapped rather than resolved to `low` (R24, spec 0195 R11).\"\n  - id: \"guidance\"\n    kind: \"guidance\"\n    carries:\n      - \"model\"\n      - \"reasoning\"\n    template: \"Run this agent on the {{model}} model.\\nGive its work {{reasoning}} reasoning effort.\\n\"\n    items:\n      - item: \"model\"\n        grounds:\n          - declares: \"item\"\n            assumption: \"An orchestrating Claude Code session asked in prose to run an agent on a named model does so. The whole of the evidence is the maintainer's live experience, recorded at the content gate of issue #1111; no probe covers it, and RR tested no orchestrator behaviour (R35, spec 0197 Decision 6).\"\n      - item: \"reasoning\"\n        grounds:\n          - declares: \"item\"\n            assumption: \"Same ground as the model item above. Additionally unverified: whether prose naming a model inside a .claude/agents/ output disturbs a GitHub Copilot CLI reader — probe A set a `model:` field on every leg, so its verdict says nothing about prose. Tracked as probe C from content gate v2 of issue #1111.\"\nofferings:\n  - id: \"haiku\"\n    rank: 1\n    native-value: \"haiku\"\n    provides:\n      intelligence: \"medium\"\n      specialization: \"general\"\n    encodes:\n      intelligence: \"haiku\"\n    supports-reasoning-surface: true\n    grounds:\n      - declares: \"native-value\"\n        citation: \"RR -> Claude Code -> Declaration surface: `haiku` is a known alias of the --model domain (not itself printed in the help example, which lists fable/opus/sonnet).\"\n      - declares: \"provides.intelligence\"\n        citation: \"Spec 0195 R7's normative anchor table calibrates rung 3 `medium` on Claude Code `haiku` (spec 0197 R36).\"\n      - declares: \"supports-reasoning-surface\"\n        citation: \"Live empirical verification on Claude Code 2.1.263: the `haiku` alias resolves to `claude-haiku-4-5-20251001`, which natively supports extended thinking. An agent defined with `model: haiku` and `effort: medium` cleanly executes and emits thinking tokens without error (spec 0197 delta-02 R36).\"\n      - declares: \"supports-reasoning-surface.behavior\"\n        citation: \"Spec 0197 delta-02 R36: with `supports-reasoning-surface: true`, Claude Code directs a declared reasoning rung to `effort:` in frontmatter and to the guidance surface prose without dropping.\"\n  - id: \"sonnet\"\n    rank: 2\n    native-value: \"sonnet\"\n    provides:\n      intelligence: \"high\"\n      specialization: \"general\"\n    encodes:\n      intelligence: \"sonnet\"\n    supports-reasoning-surface: true\n    grounds:\n      - declares: \"native-value\"\n        citation: \"RR -> Claude Code -> Declaration surface: `sonnet` appears in `claude --help`'s own --model example.\"\n      - declares: \"provides.intelligence\"\n        citation: \"Spec 0195 R7's normative anchor table calibrates rung 4 `high` on Claude Code `sonnet` (spec 0197 R36).\"\n  - id: \"opus\"\n    rank: 3\n    native-value: \"opus\"\n    provides:\n      intelligence: \"xhigh\"\n      specialization: \"general\"\n    encodes:\n      intelligence: \"opus\"\n    supports-reasoning-surface: true\n    grounds:\n      - declares: \"native-value\"\n        citation: \"RR -> Claude Code -> Declaration surface: `opus` appears in `claude --help`'s own --model example.\"\n      - declares: \"provides.intelligence\"\n        citation: \"Spec 0195 R7's normative anchor table calibrates rung 5 `xhigh` on Claude Code `opus` (spec 0197 R36).\"\n  - id: \"fable\"\n    rank: 4\n    native-value: \"fable\"\n    provides:\n      intelligence: \"xxhigh\"\n      specialization: \"general\"\n    encodes:\n      intelligence: \"fable\"\n    supports-reasoning-surface: true\n    grounds:\n      - declares: \"native-value\"\n        citation: \"RR -> Claude Code -> Declaration surface: `fable` appears in `claude --help`'s own --model example.\"\n      - declares: \"provides.intelligence\"\n        citation: \"Spec 0195 R7's normative anchor table calibrates rung 6 `xxhigh` on Claude Code `fable` (spec 0197 R36). Under R17's ceiling clause this offering also serves a declared `max` rung, satisfying spec 0195 R9.\"\n  - id: \"o11-extra-claude\"\n    rank: 20\n    native-value: \"o11-extra-native\"\n    provides:\n      intelligence: \"max\"\n      specialization: \"general\"\n    encodes:\n      intelligence: \"o11-extra-claude\"\n    supports-reasoning-surface: false\n    grounds:\n      - declares: \"native-value\"\n        assumption: \"fixture\"\n      - declares: \"provides.intelligence\"\n        assumption: \"fixture\"\n      - declares: \"supports-reasoning-surface\"\n        assumption: \"fixture\"\nguard:\n  id: \"copilot-shared-read\"\n  spec: \"specs/0143-copilot-subagent-model-fallback.delta-01.md R8\"\n  state: \"withheld\"\n  terms:\n    - id: \"defect-not-established-fixed\"\n      statement: \"The upstream defect github/copilot-cli#4437 is not established fixed.\"\n      holds: true\n      evidence: \"Probe run 20260902T153919Z-0aa9 of issue #1103 returned the verdict BUG-PRESENT against github/copilot-cli#4437 on GitHub Copilot CLI 1.0.82 (spec 0197 R37).\"\n      grounds:\n        - declares: \"holds\"\n          citation: \"Probe run 20260902T153919Z-0aa9 of issue #1103, verdict BUG-PRESENT (spec 0197 R37).\"\n    - id: \"copilot-reader-consumes-claude-surface\"\n      statement: \"A GitHub Copilot CLI reader may consume the .claude/agents/ surface.\"\n      holds: true\n      evidence: \"The control leg of the same probe run 20260902T153919Z-0aa9 is direct live evidence that GitHub Copilot CLI consumes the .claude/agents/ surface; RR -> GitHub Copilot CLI -> Shared-read hazard records probe B on Copilot CLI 1.0.82 finding all three cells CONSUMED, nested and flat under .claude/agents/ and at ~/.copilot/agents/ (spec 0197 R37).\"\n      grounds:\n        - declares: \"holds\"\n          citation: \"Probe run 20260902T153919Z-0aa9 control leg, and probe B's three-cell CONSUMED outcome on Copilot CLI 1.0.82 (spec 0197 R37).\"\n"
  }
