   "extra/xo_guard-terms#1/claude": {
    "offeringId": "fable",
    "nativeValue": "fable",
    "fmLines": [],
    "prose": "Run this agent on the fable model.",
    "diagLines": [
     "model-note\tprobe\tclaude\tguard-withheld\tterms=copilot-reader-consumes-claude-surface,brand-new surface=guidance"
    ],
    "handle": "<MERGE>/23baac8aacb8d0b2a770fd4a235c450f1606ebdeba0e1dd710d27b60bb7af24a/claude.yml",
