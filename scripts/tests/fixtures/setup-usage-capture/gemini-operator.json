{
  "theme": "Default",
  "general": {
    "vimMode": true
  },
  "hooks": {
    "AfterModel": [
      {
        "hooks": [
          {
            "type": "command",
            "name": "operator-after-model",
            "command": "/opt/operator/bin/after-model.sh"
          },
          {
            "type": "command",
            "name": "usage-capture-agent-response",
            "command": "bash __CAPTURE_ABS__ gemini-cli AfterModel"
          }
        ]
      }
    ]
  }
}
