{
  "model": "opus",
  "permissions": {
    "allow": [
      "Bash(ls:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/operator/bin/lint-on-edit.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/operator/bin/notify-done.sh"
          },
          {
            "type": "command",
            "command": "bash \"__CAPTURE_ABS__\" claude-code Stop"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"__CAPTURE_ABS__\" claude-code SessionEnd"
          }
        ]
      }
    ]
  }
}
