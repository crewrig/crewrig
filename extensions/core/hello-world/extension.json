{
  "name": "hello-world",
  "version": "1.7.0",
  "description": "Demonstration extension showcasing MCP tools, commands, skills, and context.",
  "mcpServers": {
    "default": {
      "command": "node",
      "args": [
        "${extensionRoot}/dist/index.js"
      ]
    }
  },
  "commands": {
    "location": "commands/",
    "convertToSkills": true
  },
  "skills": {
    "location": "skills/"
  },
  "context": {
    "source": "CONTEXT.md"
  },
  "hooks": [
    {
      "id": "shell-logger",
      "event": "PreToolUse",
      "matcher": "shell",
      "command": "bash ${extensionRoot}/hooks/shell-logger.sh",
      "description": "Maps-everywhere example (spec 0179 R18): fires before every shell-class tool call on every supported target."
    },
    {
      "id": "prompt-logger",
      "event": "UserPromptSubmit",
      "command": "bash ${extensionRoot}/hooks/prompt-logger.sh",
      "description": "Maps-partially example (spec 0179 R18): no counterpart on the Antigravity CLI (see extensions/core/hello-world/accepted-gaps.json)."
    }
  ],
  "gemini": {
    "themes": []
  },
  "claude": {
    "author": {
      "name": "crewrig contributors"
    },
    "skills": [
      "skills/*/SKILL.md"
    ],
    "agents": [],
    "rules": [],
    "defaultAllowedTools": [
      "Read",
      "Write",
      "Edit",
      "Bash"
    ],
    "settings": {},
    "lsp": {},
    "bin": null
  }
}
