{
  "version": 1,
  "hooks": {
    "agentStop": [
      {
        "type": "command",
        "command": "node \"${COPILOT_PROJECT_DIR:-$PWD}/hooks/usage-capture.ts\" copilot-cli agentStop"
      }
    ],
    "sessionEnd": [
      {
        "type": "command",
        "command": "node \"${COPILOT_PROJECT_DIR:-$PWD}/hooks/usage-capture.ts\" copilot-cli sessionEnd"
      }
    ]
  }
}
