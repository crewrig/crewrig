#!/usr/bin/env node
// CrewRig pre-push guard (spec 0279 R14): a thin bootstrap, all logic lives in scripts/ci-pre-push.ts.
// Skip it with `git push --no-verify`; CI stays authoritative.
if (typeof process.getBuiltinModule !== 'function') {
  process.stderr.write('pre-push: this hook requires Node.js >= 24 (the CrewRig floor).\n');
  process.exit(1);
}
const { spawnSync } = process.getBuiltinModule('node:child_process');
const fs = process.getBuiltinModule('node:fs');
const top = spawnSync('git', ['rev-parse', '--show-toplevel'], { encoding: 'utf8' });
if (top.status !== 0) {
  process.stderr.write('pre-push: cannot resolve the repository toplevel with git rev-parse.\n');
  process.exit(1);
}
const cwd = top.stdout.trim();
if (!fs.existsSync(`${cwd}/taskfiles/ci.yml`)) {
  process.stdout.write(`pre-push: ${cwd} is not a CrewRig checkout (no taskfiles/ci.yml): nothing to check.\n`);
  process.exit(0);
}
let refs = '';
try {
  refs = fs.readFileSync(0, 'utf8');
} catch {
  refs = '';
}
const [remote = '', url = ''] = process.argv.slice(2);
const run = spawnSync('task', ['ci:pre-push', '--', remote, url], {
  cwd,
  stdio: ['ignore', 'inherit', 'inherit'],
  env: { ...process.env, PWD: cwd, CREWRIG_PRE_PUSH_REFS: refs },
});
if (run.error?.code === 'ENOENT') {
  process.stderr.write('pre-push: task is not on PATH: install Task >= 3.39 (https://taskfile.dev/installation/) and Node.js >= 24, or push with --no-verify.\n');
  process.exit(1);
}
process.exit(run.status ?? 1);
