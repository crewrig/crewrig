diff --git a/src/widgets/retry.py b/src/widgets/retry.py
new file mode 100644
--- /dev/null
+++ b/src/widgets/retry.py
@@ -0,0 +1,18 @@
+"""Retry helper for flaky widget calls."""
+
+import time
+
+
+def retry(call, attempts=3, delay=0.2):
+    """Call `call` until it succeeds, at most `attempts` times.
+
+    When every attempt fails, the last error is raised to the caller.
+    """
+    last = None
+    for _ in range(attempts):
+        try:
+            return call()
+        except Exception as exc:
+            last = exc
+            time.sleep(delay)
+    return None
diff --git a/tests/test_retry.py b/tests/test_retry.py
new file mode 100644
--- /dev/null
+++ b/tests/test_retry.py
@@ -0,0 +1,9 @@
+from widgets.retry import retry
+
+
+def test_retry_returns_the_value_on_success():
+    assert retry(lambda: 42) == 42
+
+
+def test_retry_succeeds_after_one_failure():
+    calls = iter([RuntimeError("boom"), 7])
+    def flaky():
+        item = next(calls)
+        if isinstance(item, Exception):
+            raise item
+        return item
+    assert retry(flaky, delay=0) == 7
