+
+test("getWidget retries a 503 and then succeeds", async () => {
+  server.respondWith([503, 503, 200]);
+  const client = new WidgetClient({ baseUrl: server.url });
+  await expect(client.getWidget("w1")).resolves.toMatchObject({ id: "w1" });
+  expect(server.requestCount).toBe(3);
+});
+
+test("getWidget gives up after maxRetries", async () => {
+  server.respondWith([503, 503, 503, 503, 503]);
+  const client = new WidgetClient({ baseUrl: server.url, maxRetries: 2 });
+  await expect(client.getWidget("w1")).rejects.toThrow("HTTP 503");
+  expect(server.requestCount).toBe(3);
+});
